# StayFlow Hotel Management System - Frontend Environment Configuration

# -------------------------------------------------------------
# For Local Development:
# -------------------------------------------------------------
# VITE_API_BASE_URL=http://127.0.0.1:8000

# -------------------------------------------------------------
# For Vercel Production Deployment:
# -------------------------------------------------------------
# In Vercel Project Dashboard -> Settings -> Environment Variables:
# Add VITE_API_BASE_URL pointing to your Railway backend deployment URL (no trailing slash):
VITE_API_BASE_URL=https://your-backend-app.up.railway.app
